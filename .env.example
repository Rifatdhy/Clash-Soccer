# Database Configuration
# Neon/Supabase/cloud PG: gunakan connection string yang disediakan (biasanya berisi ?sslmode=require)
# VPS PostgreSQL tanpa SSL: tambahkan ?sslmode=disable di akhir URL
DATABASE_URL="postgresql://user:password@host:port/database"

# Admin Credentials — WAJIB diganti sebelum deploy!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Session Secret — string acak panjang. Generate: openssl rand -base64 48
ADMIN_AUTH_SECRET=

# SSL (opsional, untuk VPS yang memakai sertifikat self-signed)
# PG_REJECT_UNAUTHORIZED=false
# PG_CA_CERT=/path/to/ca.crt
