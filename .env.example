# ============================================================================
# Clash.Soccer environment template
# Copy to .env.local for local development, or set these in your host.
# Values marked (required in production) are enforced by src/lib/env.ts.
# ============================================================================

# --- Database -----------------------------------------------------------------
# Required in production. PostgreSQL 15+.
# Cloud providers usually include ?sslmode=require.
# Plain local/VPS Postgres without TLS: append ?sslmode=disable.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clash_soccer"

# Optional. Used only by `npm run test:integration`; tests skip when unset.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clash_soccer"

# --- Admin authentication -----------------------------------------------------
# Required in production.
ADMIN_USERNAME=admin

# Preferred: a scrypt hash. Generate one with:
#   npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=

# Legacy fallback. Works until you set ADMIN_PASSWORD_HASH.
# Required in production only when ADMIN_PASSWORD_HASH is empty.
ADMIN_PASSWORD=

# Required in production. At least 32 characters of random data.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ADMIN_AUTH_SECRET=

# --- Site ---------------------------------------------------------------------
# Required in production. Absolute http(s) URL used by metadata, sitemap,
# robots.txt, JSON-LD, and canonical links. No trailing slash needed.
SITE_URL="http://localhost:3000"

# --- Database TLS (optional) --------------------------------------------------
# Only for a VPS with a self-signed certificate.
# PG_REJECT_UNAUTHORIZED=false
# PG_CA_CERT=/path/to/ca.crt

# --- Rate limiting ------------------------------------------------------------
# memory (default) keeps counters per process. Use database when you run more
# than one instance and have run `npm run db:migrate` (creates rate_limits).
# RATE_LIMIT_STORE=memory

# --- Uploads / object storage -------------------------------------------------
# local (default) writes to UPLOAD_DIR and serves files from /api/uploads/*.
# Local storage needs a writable disk; on serverless hosts use s3.
# STORAGE_DRIVER=local
# UPLOAD_DIR=.data/uploads

# S3-compatible storage, used only when STORAGE_DRIVER=s3.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # e.g. https://s3.example.com for non-AWS providers
# Images are served through /api/uploads/* for both drivers.

# --- Observability (optional) -------------------------------------------------
# When set, reportError sends a best-effort Sentry envelope (2s timeout).
# Without it, errors are only written to the structured JSON log.
# SENTRY_DSN=
